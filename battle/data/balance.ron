// Global balance knobs. Times are seconds, speeds are units/second.
(
    tick_rate: 60,
    max_battle_seconds: 90.0,
    // damage = power * attack / defense * damage_scale * stab * type * variance
    damage_scale: 0.22,
    damage_variance: 0.1,
    stab: 1.05,
    attack_move_mult: 0.4,
    acceleration: 14.0,
    knockback_decay: 7.0,
    dash: (
        speed: 2.6,
        duration: 0.18,
        cooldown: 1.1,
        iframes: 0.16,
        cancels_recovery: true,
    ),
    ai_profiles: {
        "easy": (
            reaction_time: 0.35, dodge_chance: 0.25, threat_lookahead: 0.4,
            aggression: 0.5, aim_error_deg: 12.0, lead: 0.3,
            range_band: 50.0, strafe_switch: 2.0, strafe_amount: 0.5, kite_range: 280.0,
        ),
        "normal": (
            reaction_time: 0.22, dodge_chance: 0.55, threat_lookahead: 0.45,
            aggression: 0.7, aim_error_deg: 6.0, lead: 0.6,
            range_band: 40.0, strafe_switch: 1.6, strafe_amount: 0.7, kite_range: 300.0,
        ),
        "hard": (
            reaction_time: 0.12, dodge_chance: 0.85, threat_lookahead: 0.5,
            aggression: 0.9, aim_error_deg: 3.0, lead: 0.9,
            range_band: 30.0, strafe_switch: 1.2, strafe_amount: 0.8, kite_range: 300.0,
        ),
    },
)
