    (
        id: "snowfield",
        art: "snowfield",
        width: 1200.0,
        height: 600.0,
        spawns: [(x: 230.0, y: 300.0), (x: 970.0, y: 300.0)],
        // Four rocks around an open centre.
        pillars: [
            (pos: (x: 420.0, y: 160.0), radius: 34.0),
            (pos: (x: 780.0, y: 160.0), radius: 34.0),
            (pos: (x: 420.0, y: 440.0), radius: 34.0),
            (pos: (x: 780.0, y: 440.0), radius: 34.0),
        ],
    ),
