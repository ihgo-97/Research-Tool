// Presentation assets, keyed by the `asset` ids in data/*.ron.
// Paths are relative to this folder. A missing or broken sprite falls back to
// a coloured circle; a missing sound is silent. Swap art here, never in code.
(
    // Creature sprite sheets: `columns` frames per row. Each animation starts
    // at its `rows` entry and has one row per facing (down, up, side); side
    // faces right and is mirrored for left. Frames are drawn at `pixel_scale`
    // game units per pixel, with frame pixel `anchor` on the creature's centre.
    // `portrait` is the HUD crop of the first idle-down frame.
    // The current sheets are generated placeholders: `cargo run --release --bin gen_sprites`.
    sheet: (
        frame_size: 64,
        columns: 4,
        rows: (idle: 0, walk: 3, attack: 6, hurt: 9),
        facings: 3,
        fps: 8.0,
        pixel_scale: 2.0,
        anchor: (32.0, 46.0),
        portrait: (x: 6.0, y: 4.0, w: 52.0, h: 48.0),
    ),
    // Arena themes, chosen by `art` in data/arena.ron. `obstacle` is a strip of
    // 64px rock variants drawn at pixel_scale.
    arena_art: {
        "snowfield": (ground: "arena/snow.png", obstacle: "arena/rocks_snow.png", snow: true, border: (120, 136, 168)),
        "meadow":    (ground: "arena/grass.png", obstacle: "arena/rocks.png", snow: false, border: (70, 104, 60)),
    },
    // Sound ids played on battle events (None = silent). Played only when built
    // with `--features audio`.
    sounds: {
        "launch": None,
        "hit": None,
        "hit_strong": None,
        "dodge": None,
        "dash": None,
        "ko": None,
        "status": None,
        "switch": None,
        "send_out": None,
    },
    // Status display: short HUD badge, pop-up text when inflicted, colour.
    statuses: {
        "burn":      (badge: "BRN", inflicted: "BURNED!", color: (240, 110, 48)),
        "paralysis": (badge: "PAR", inflicted: "PARALYZED!", color: (236, 196, 40)),
        "sleep":     (badge: "SLP", inflicted: "FELL ASLEEP!", color: (150, 150, 178)),
    },
    types: {
        "normal":   (name: "Normal",   color: (168, 168, 140)),
        "fire":     (name: "Fire",     color: (240, 110, 48)),
        "water":    (name: "Water",    color: (70, 140, 240)),
        "grass":    (name: "Grass",    color: (100, 196, 80)),
        "electric": (name: "Electric", color: (245, 205, 50)),
        "rock":     (name: "Rock",     color: (176, 150, 92)),
        "wind":     (name: "Wind",     color: (150, 210, 220)),
    },
    creatures: {
        "emberkit": (name: "Emberkit", color: (232, 96, 52), sprite: Some("sprites/emberkit.png")),
        "tidepup":  (name: "Tidepup",  color: (64, 130, 220), sprite: Some("sprites/tidepup.png")),
        "sproutle": (name: "Sproutle", color: (84, 176, 76), sprite: Some("sprites/sproutle.png")),
        "voltfin":  (name: "Voltfin",  color: (236, 196, 40), sprite: Some("sprites/voltfin.png")),
        "pebblor":  (name: "Pebblor",  color: (150, 128, 96), sprite: Some("sprites/pebblor.png")),
        "galeon":   (name: "Galeon",   color: (130, 196, 206), sprite: Some("sprites/galeon.png")),
    },
    moves: {
        "tackle":       (name: "Tackle"),
        "swift_star":   (name: "Swift Star"),
        "ember":        (name: "Ember"),
        "fire_fang":    (name: "Fire Fang"),
        "flame_burst":  (name: "Flame Burst"),
        "water_jet":    (name: "Water Jet"),
        "tidal_ring":   (name: "Tidal Ring"),
        "seed_spray":   (name: "Seed Spray"),
        "vine_lash":    (name: "Vine Lash"),
        "spore_burst":  (name: "Spore Burst"),
        "spark":        (name: "Spark"),
        "thunder_drop": (name: "Thunder Drop"),
        "rock_throw":   (name: "Rock Throw"),
        "quake":        (name: "Quake"),
        "gust":         (name: "Gust"),
        "air_slash":    (name: "Air Slash"),
    },
)
