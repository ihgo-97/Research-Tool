// Presentation assets, keyed by the `asset` ids in data/*.ron.
// Paths are relative to this folder. A missing or broken sprite falls back to
// a coloured circle; a missing sound is silent. Swap art here, never in code.
(
    // Creature sprite sheets: `columns` frames per row. Each animation starts
    // at its `rows` entry and has one row per facing (down, up, side); side
    // faces right and is mirrored for left. Frames are drawn at `pixel_scale`
    // game units per pixel, with frame pixel `anchor` on the creature's centre.
    // `portrait` is the HUD crop of the first idle-down frame.
    // The current sheets are generated placeholders: `cargo run --release --bin gen_sprites`.
    sheet: (
        frame_size: 64,
        columns: 4,
        rows: (idle: 0, walk: 3, attack: 6, hurt: 9),
        facings: 3,
        fps: 8.0,
        pixel_scale: 2.0,
        anchor: (32.0, 46.0),
        portrait: (x: 6.0, y: 4.0, w: 52.0, h: 48.0),
    ),
    // Arena themes, chosen by `art` in data/arena.ron. `obstacle` is a strip of
    // 64px rock variants drawn at pixel_scale.
    arena_art: {
        "snowfield": (ground: "arena/snow.png", obstacle: "arena/rocks_snow.png", obstacle_radius: 34.0, snow: true, border: (120, 136, 168)),
        "meadow":    (ground: "arena/grass.png", obstacle: "arena/rocks.png", obstacle_radius: 34.0, snow: false, border: (70, 104, 60)),
    },
    // Sounds played on battle events (None = silent); moves have their own
    // `sound` (played on launch instead of "launch"). Only with `--features audio`.
    // The current sounds are synthesised placeholders: `cargo run --release --bin gen_sfx`.
    sounds: {
        "launch": Some("sfx/launch.wav"),
        "hit": Some("sfx/hit.wav"),
        "hit_strong": Some("sfx/hit_strong.wav"),
        "dodge": Some("sfx/dodge.wav"),
        "dash": Some("sfx/dash.wav"),
        "ko": Some("sfx/ko.wav"),
        "status": Some("sfx/status.wav"),
        "switch": Some("sfx/switch.wav"),
        "send_out": Some("sfx/send_out.wav"),
    },
    // Status display: short HUD badge, pop-up text when inflicted, colour.
    statuses: {
        "burn":      (badge: "BRN", inflicted: "BURNED!", color: (240, 110, 48)),
        "paralysis": (badge: "PAR", inflicted: "PARALYZED!", color: (236, 196, 40)),
        "sleep":     (badge: "SLP", inflicted: "FELL ASLEEP!", color: (150, 150, 178)),
    },
    types: {
        "normal":   (name: "Normal",   color: (168, 168, 140)),
        "fire":     (name: "Fire",     color: (240, 110, 48)),
        "water":    (name: "Water",    color: (70, 140, 240)),
        "grass":    (name: "Grass",    color: (100, 196, 80)),
        "electric": (name: "Electric", color: (245, 205, 50)),
        "rock":     (name: "Rock",     color: (176, 150, 92)),
        "wind":     (name: "Wind",     color: (150, 210, 220)),
    },
    creatures: {
        "emberkit": (name: "Emberkit", color: (232, 96, 52), sprite: Some("sprites/emberkit.png")),
        "tidepup":  (name: "Tidepup",  color: (64, 130, 220), sprite: Some("sprites/tidepup.png")),
        "sproutle": (name: "Sproutle", color: (84, 176, 76), sprite: Some("sprites/sproutle.png")),
        "voltfin":  (name: "Voltfin",  color: (236, 196, 40), sprite: Some("sprites/voltfin.png")),
        "pebblor":  (name: "Pebblor",  color: (150, 128, 96), sprite: Some("sprites/pebblor.png")),
        "galeon":   (name: "Galeon",   color: (130, 196, 206), sprite: Some("sprites/galeon.png")),
    },
    // `vfx` picks the effect drawn for the move (see crates/game/src/vfx.rs);
    // `sound` plays when it launches.
    moves: {
        "tackle":       (name: "Tackle", vfx: "impact", sound: Some("sfx/normal.wav")),
        "swift_star":   (name: "Swift Star", vfx: "star", sound: Some("sfx/normal.wav")),
        "ember":        (name: "Ember", vfx: "flame", sound: Some("sfx/fire.wav")),
        "fire_fang":    (name: "Fire Fang", vfx: "bite", sound: Some("sfx/fire.wav")),
        "flame_burst":  (name: "Flame Burst", vfx: "flame_ring", sound: Some("sfx/fire.wav")),
        "water_jet":    (name: "Water Jet", vfx: "jet", sound: Some("sfx/water.wav")),
        "tidal_ring":   (name: "Tidal Ring", vfx: "splash", sound: Some("sfx/water.wav")),
        "seed_spray":   (name: "Seed Spray", vfx: "seed", sound: Some("sfx/grass.wav")),
        "vine_lash":    (name: "Vine Lash", vfx: "whip", sound: Some("sfx/grass.wav")),
        "spore_burst":  (name: "Spore Burst", vfx: "spores", sound: Some("sfx/grass.wav")),
        "spark":        (name: "Spark", vfx: "bolt", sound: Some("sfx/electric.wav")),
        "thunder_drop": (name: "Thunder Drop", vfx: "lightning", sound: Some("sfx/electric.wav")),
        "rock_throw":   (name: "Rock Throw", vfx: "boulder", sound: Some("sfx/rock.wav")),
        "quake":        (name: "Quake", vfx: "quake", sound: Some("sfx/rock.wav")),
        "gust":         (name: "Gust", vfx: "gust", sound: Some("sfx/wind.wav")),
        "air_slash":    (name: "Air Slash", vfx: "slash", sound: Some("sfx/wind.wav")),
    },
)
